    "test:environment-parity": "node scripts/browser/check-environment-parity.mjs",
    "assets:split-terrain": "node scripts/split-terrain-glb.mjs",
    "assets:share-textures": "node scripts/share-glb-textures.mjs",
    "assets:fantasy": "node scripts/generate-fantasy-assets.mjs",
    "assets:loading-art": "node scripts/optimize-loading-art.mjs",
    "assets:alpine-trees": "node scripts/generate-alpine-trees.mjs",
